{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        cheshire/cheshire {:mvn/version "6.2.1"}
        hato/hato {:mvn/version "1.0.0"}
        hiccup/hiccup {:mvn/version "2.0.0"}
        ring/ring-core {:mvn/version "1.15.6"}
        ring/ring-jetty-adapter {:mvn/version "1.15.6"}
        metosin/reitit-ring {:mvn/version "0.11.0"}}
 :aliases
 {:run-m {:main-opts ["-m" "crestron-week-display.core"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}}}
